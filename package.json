{
  "name": "ai-daily-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 8000",
    "validate:frontend": "playwright test --config=playwright.config.mjs",
    "validate:data": "python scripts/validate_news_data.py",
    "sync:news": "python scripts/update_ai_news.py",
    "publish:opinion": "python scripts/generate_opinion.py",
    "publish:weekly": "python scripts/generate_weekly.py",
    "validate:opinion": "python -m unittest discover -s tests -p test_generate_opinion.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
